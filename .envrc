# Foyer — committed direnv config.
#
# Provides the Nix dev shell plus safe defaults for every runtime env var the
# app reads in dev. Real secrets and per-developer overrides go in
# `.envrc.local` (gitignored). See `.envrc.local.sample` for what to put there.

use flake

# --- Phoenix runtime config -------------------------------------------------

# 64+ char dummy. Real value comes from `.envrc.local` (or is generated for
# prod). Phoenix will refuse to boot in prod with this placeholder.
export SECRET_KEY_BASE="dev_secret_key_base_padding_padding_padding_padding_padding_padding_pad"
export PHX_HOST="localhost"
export PORT="4000"

# --- Database --------------------------------------------------------------

# Dummy DATABASE_URL — override in `.envrc.local` with the real connection
# string for your local Postgres.
export DATABASE_URL="ecto://postgres:postgres@localhost:5432/foyer_dev"
export TEST_DATABASE_URL="ecto://postgres:postgres@localhost:5432/foyer_test"

# --- Project-local Postgres (used by `bin/db`) -----------------------------
# These point the bundled `bin/db` helper at a Postgres cluster that lives
# entirely inside `./.postgres`. Safe to keep here — they are not secrets.

export PGDATA="$PWD/.postgres/data"
export PGLOG="$PWD/.postgres/postgres.log"
export PGHOST="localhost"
export PGPORT="5432"
export PGUSER="postgres"

# --- Per-developer overrides ----------------------------------------------

source_env_if_exists .envrc.local
